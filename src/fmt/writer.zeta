/// fn dynamic_writer(use_stderr: bool) -> impl Subscriber {
/// let writer = if use_stderr {
/// BoxMakeWriter::new(std::io::stderr)
/// } else {
/// BoxMakeWriter::new(std::io::stdout)
/// };
