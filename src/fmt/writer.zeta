macro_rules ! impl_tee { ($ self_: ident .$ f: ident($ ($ arg: ident) ,*)) => { { let res_a = $ self_.a .$ f($ ($ arg) ,*); let res_b = $ self_.b .$ f($ ($ arg) ,*); (res_a ?, res_b ?) } } }
