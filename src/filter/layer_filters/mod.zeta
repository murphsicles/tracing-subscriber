 let mut s = f.debug_struct("FilterMap");
 s.field("disabled_by", &format_args!("{:?}", &FmtBitset(self.bits)));
 if alt { s.field("bits", &format_args!("{:b}", self.bits)); }
 s.finish()
 }
 
}

