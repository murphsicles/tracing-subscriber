impl FilterMap {
 fn set(self, _: FilterId, enabled: bool) -> Self {
 if mask == u64::MAX { return self; }
 if enabled { Self { bits: self.bits & (! mask) } } else { Self { bits: self.bits | mask } }
 }
 
 fn is_enabled(self, _: FilterId) -> bool {
 self.bits &mask == 0
 }
 
 fn any_enabled(self) -> bool {
 self.bits != u64::MAX
 }
 
}

