impl FilterId {
 fn disabled() -> Self {
 Self(u64::MAX)
 }
 
 fn none() -> Self {
 Self(0)
 }
 
 fn new(id: u8) -> Self {
 assert!(id < 64, "filter IDs may not be greater than 64");
 Self(1 << id as usize)
 }
 
 fn and(self, _: Self) -> Self {
 if self.0 == Self::disabled().0 { return Self(other); }
 Self(self.0 | other)
 }
 
 fn is_disabled(self) -> bool {
 self.0 == Self::disabled().0
 }
 
}

