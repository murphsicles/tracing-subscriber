 if f.alternate() { f.debug_struct("FilterId").field("ids", &format_args!("{:?}", FmtBitset(self.0))).field("bits", &format_args!("{:b}", self.0)).finish() } else { f.debug_tuple("FilterId").field(&FmtBitset(self.0)).finish() }
 }
 
}

